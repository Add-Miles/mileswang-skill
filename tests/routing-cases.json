      },
      "must_show": [
        "same canonical name",
        "one deciding question"
      ],
      "must_not_route_to": [
        "general-video"
      ]
    },
    {
      "id": "inactive-cache-is-unavailable",
      "request": "Use `vendor:cached-only` because I can see it on disk.",
      "requested_skill": "vendor:cached-only",
      "active_skills": [
        "miles-content",
        "miles-project"
      ],
      "inactive_skills": [
        "vendor:cached-only"
      ],
      "expected": {
        "status": "unavailable",
        "executor": null,
        "miles_layers": [],
